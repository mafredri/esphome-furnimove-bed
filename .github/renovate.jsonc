{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  // Rebase on every main change so each pull request is tested against the
  // main it merges into.
  "rebaseWhen": "behind-base-branch",
  "timezone": "Europe/Helsinki",
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "!esphome"
      ],
      "groupName": "dev tools"
    },
    {
      // The packages target ESPHome, and its releases can break them, so
      // each one gets its own pull request.
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "esphome"
      ],
      "commitMessageTopic": "ESPHome"
    },
    {
      // ESPHome's dependencies had no wheels for Python 3.15; 3.14 is untested.
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "python/cpython"
      ],
      "allowedVersions": "<3.14"
    }
  ]
}
